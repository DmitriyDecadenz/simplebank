# Copy to .env. Compose reads this file both for ${VAR} substitution and,
# via env_file, injects it into the web container.
# Settings use the SECTION__KEY convention (see src/infrastructure/config.py).

# PostgreSQL. POSTGRES__HOST is overridden to "db" inside docker-compose.
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=simplebank
POSTGRES__PASSWORD=simplebank
POSTGRES__DB=simplebank

# Application.
APP__ENVIRONMENT=local

# JWT auth.
AUTH__SECRET_KEY=change-me-in-production
AUTH__ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
